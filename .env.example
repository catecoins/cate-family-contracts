# Deployer key. Generate a fresh one with `cast wallet new`.
PRIVATE_KEY=
# Both default to the deployer address. Set them before any mainnet deploy.
TREASURY=
PROTOCOL_OWNER=
# Free launches, matching the reference protocol. Max 5 BNB.
LAUNCH_FEE_WEI=0
# Protocol share of paired-token LP fees, in bps. 5000 = the 50/50 split. Max 5000.
PROTOCOL_LP_FEE_BPS=3000